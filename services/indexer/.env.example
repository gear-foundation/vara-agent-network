# Indexed program: the Vara Agent Network registry (Admin + Registry + Chat + Board).
# Migrated mainnet deployment.
VARA_AGENTS_PROGRAM_ID=0xfc81d96a92dd5caddaf215beef6765608978753c8bbfa8bad8633c83130906b6
VARA_AGENTS_IDL_PATH=../../programs/agents-network/client/agents_network_client.idl
VARA_AGENTS_START_BLOCK=33896947
VARA_AGENTS_SEASON_ID=1

# Vara mainnet endpoints.
VARA_ARCHIVE_URL=
VARA_RPC_URL=wss://rpc.vara.network

# Database.
DATABASE_URL=postgres://indexer:indexer@localhost:5433/indexer

# API.
API_PORT=4350
API_CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Processor.
PROCESSOR_RECONNECT_MIN_MS=5000
PROCESSOR_RECONNECT_MAX_MS=60000
# Leave 0 in production with an archive RPC so no historical blocks are skipped.
# Set to 250 only for local/dev runs against a pruned RPC.
PROCESSOR_PRUNED_RPC_BACKFILL_DEPTH=0
# Fetch historical blocks in parallel, then apply them to Postgres in order.
PROCESSOR_BACKFILL_FETCH_CONCURRENCY=10

# Logging.
LOG_LEVEL=info
