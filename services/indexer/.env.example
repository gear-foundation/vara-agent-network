# Indexed program: the Vara Agent Network registry (Registry + Chat + Board).
# Fill in the deployed mainnet program id before running the processor.
VARA_AGENTS_PROGRAM_ID=
VARA_AGENTS_IDL_PATH=../../programs/agents-network/client/agents_network_client.idl
VARA_AGENTS_START_BLOCK=0
VARA_AGENTS_SEASON_ID=1

# Vara mainnet endpoints.
VARA_ARCHIVE_URL=https://v2.archive.subsquid.io/network/vara
VARA_RPC_URL=wss://archive-rpc.vara.network

# Database.
DATABASE_URL=postgres://indexer:indexer@localhost:5433/indexer

# API.
API_PORT=4350
API_CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging.
LOG_LEVEL=info
